<Project Sdk="Microsoft.NET.Sdk">

  <!-- 游戏根目录（exe 所在目录）。默认为 Steam 实际安装目录，
       可用 -p:GameDir=路径 覆盖（如开发拷贝） -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">E:\Program Files (x86)\Steam\steamapps\common\DemonicMahjong</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ScorePreview</RootNamespace>
    <AssemblyName>ScorePreview</AssemblyName>
    <Version>0.1.0</Version>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 -->
    <Reference Include="BepInEx.Core" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <!-- Harmony + il2cpp 方法钩子支持（用于挂在 PlayerPipeline.OnProcessTingResult 上） -->
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.HarmonySupport" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.HarmonySupport.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll</HintPath>
    </Reference>

    <!-- 游戏互操作程序集：BepInEx 首次启动游戏后自动生成于 BepInEx\interop\ -->
    <!-- 注意：本游戏主体代码在 MaJiang.dll，不是 Assembly-CSharp.dll -->
    <Reference Include="MaJiang" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\MaJiang.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <!-- FanZhongs 运行时为 HashSet<FanZhong>，位于 Il2CppSystem.Core -->
    <Reference Include="Il2CppSystem.Core" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <!-- PlayerRoundStatistics 直接继承的第三方基类 -->
    <Reference Include="SaintsField.Runtime" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\SaintsField.Runtime.dll</HintPath>
    </Reference>
    <!-- TMP 文本框（计分预览面板 PlayerHuPanel 的 _baseScoreText 等） -->
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <!-- TMP_Text 基类 MaskableGraphic 所在 -->
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>