<Project Sdk="Microsoft.NET.Sdk">

  <!-- 游戏根目录（exe 所在目录）。由构建脚本传入 -p:GameDir=...（来自仓库根 .env）；
       直接 dotnet build 时读环境变量 DEMONIC_MAHJONG_DIR。真实路径只存在于 .env。 -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(DEMONIC_MAHJONG_DIR)' != ''">$(DEMONIC_MAHJONG_DIR)</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoContinue</RootNamespace>
    <AssemblyName>AutoContinue</AssemblyName>
    <Version>0.4.0</Version>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 -->
    <Reference Include="BepInEx.Core" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>

    <!-- 游戏互操作程序集：BepInEx 首次启动游戏后自动生成于 BepInEx\interop\ -->
    <Reference Include="Il2Cppmscorlib" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <!-- 灵俑演出动画：MapPlayeCharacteAnimCtrl / LingYongTimeLineController 等 -->
    <Reference Include="MaJiang" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\MaJiang.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- PlayableDirector（灵俑演出时间轴） -->
    <Reference Include="UnityEngine.DirectorModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.DirectorModule.dll</HintPath>
    </Reference>
    <!-- CanvasGroup（隐藏灵俑 UI 演出画面） -->
    <Reference Include="UnityEngine.UIModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <!-- Animator（灵俑模型演出） -->
    <Reference Include="UnityEngine.AnimationModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <!-- ParticleSystem（灵俑演出特效） -->
    <Reference Include="UnityEngine.ParticleSystemModule" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <!-- Spine 动画（灵俑演出） -->
    <Reference Include="spine-unity" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\spine-unity.dll</HintPath>
    </Reference>
    <!-- MapPlayeCharacteAnimCtrl 的基类 SaintsMonoBehaviour -->
    <Reference Include="SaintsField.Runtime" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\SaintsField.Runtime.dll</HintPath>
    </Reference>
    <!-- Button 点击对象 -->
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
    </Reference>
    <!-- TMP 文本（取按钮上的字：继续 / 点击继续） -->
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

</Project>