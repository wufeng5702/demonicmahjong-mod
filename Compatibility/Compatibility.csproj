<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(DEMONIC_MAHJONG_DIR)' != ''">$(DEMONIC_MAHJONG_DIR)</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DemonicMahjong.Compatibility</RootNamespace>
    <AssemblyName>DemonicMahjong.Compatibility</AssemblyName>
    <Version>0.4.1</Version>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 必须在 interop 生成前就能编译；只引用框架，不引用游戏或 Unity 程序集。 -->
    <Reference Include="BepInEx.Core" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Preloader.Core" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Preloader.Core.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GitVersion.cs" />
  </ItemGroup>

</Project>
